function CreateFrame(normal)

if(size(normal,1) ~= 3)
    printf("[ERROR] wrong format");
    return
end


end

function [x,y,z] SpanSpace(n)

n = normal/abs(normal); % get normilzied vector
v1 = zeros(3,1);
% generate a basic vector
if(n(1) >= n(2) && n(1) >= n(3)) % x is biggest vector
    v1 = [1;0;0];
elseif (n(2) >= n(1) && n(2) >= n(3)) % y is biggest vector
    v1 = [0;1;0];
else % z is biggest
    v1 = [0;0;1];
end

v2 = cross(n,v1);



end